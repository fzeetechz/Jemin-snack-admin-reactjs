# Local backend defaults to port 2025; change this URL if its PORT differs.
VITE_API_BASE_URL=http://localhost:2025
VITE_USE_MOCK_DATA=false

# Google Maps JavaScript API (enable the API and billing in Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your Google Maps map ID for advanced markers
VITE_GOOGLE_MAPS_MAP_ID=
